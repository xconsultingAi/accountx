# Your ERPNext SaaS site. Used by the dev server proxy only; never shipped to the browser.
ERP_URL=https://inayatco.frappe.cloud

# Company the app works with. Must match the Company name in ERPNext exactly.
VITE_COMPANY=inayatco

# Optional: where "Open in ERPNext" links point. Defaults to ERP_URL at build time.
VITE_ERP_DESK_URL=
